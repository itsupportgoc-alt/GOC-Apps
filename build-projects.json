{
  "appId": "com.gocbuilders.projects",
  "productName": "GOC Project Hub",
  "copyright": "GOC Builders",
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": [
    "main.js",
    "preload.js",
    "settings.html",
    "offline.html",
    "app-config.json",
    "package.json",
    "build/icons/**"
  ],
  "extraMetadata": {
    "name": "goc-projects",
    "productName": "GOC Project Hub",
    "gocModule": "projects"
  },
  "artifactName": "GOC-Projects-Setup.${ext}",
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "build/icons/projects.ico",
    "executableName": "GOC-Projects"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "GOC Project Hub",
    "menuCategory": "GOC Builders",
    "installerIcon": "build/icons/projects.ico",
    "uninstallerIcon": "build/icons/projects.ico",
    "uninstallDisplayName": "GOC Project Hub",
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false
  },
  "publish": [
    {
      "provider": "generic",
      "url": "https://github.com/itsupportgoc-alt/GOC-Apps/releases/latest/download",
      "channel": "projects"
    }
  ]
}